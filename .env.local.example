# Supabase project settings → API.
# Use only the public anon key in the browser. Never add the service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-side AI categorization for bank imports.
# Get a key from https://aistudio.google.com/apikey and add it to Vercel too.
# Never prefix this variable with NEXT_PUBLIC_ and never commit .env.local.
GEMINI_API_KEY=
